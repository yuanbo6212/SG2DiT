{
    "name": "fusion",
    "phase": "train",
    "gpu_ids": [5],
    "distributed": false,
    "display_port": 8097,
    "path": {
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": null
    },
    "datasets": {
        "centered": true,
        "train": {
            "name": "dataset",
            "crop_size": 256,
            "dataroot_ir": "",
            "dataroot_vi": "",

            "batch_size": 8,
            "num_workers":8,
            "use_shuffle": false,
            "is_crop"    : false
        }
    },
    "model": {
        "fusion_task": "VI-IR",
        "Unet": {
            "LDM": "Swinconv_LDM",
            "enable_freq_prior": true,
            "enable_aniso_prior": true,
            "in_ch": 1,
            "out_ch": 1,
            "LDM_embed_dim": 8,
            "LDM_ch": 64,
            "ch_mult":[1, 2, 4]
        },
        "Fusion": {
            "sample_selected": "ddp-solver++",
            "model_selected": "DFT",
            "mode":            "MAX",
            "inference_steps": 5,
            "num_train_timesteps": 1000,
            "channel_emdin": 8,
            "num_blocks":[4, 4, 4, 4],    
            "heads":   [1, 2, 4, 8],
            "feat_channels":  [32,64,128,256]
        }
    },
    "train": {
        "n_epoch": 61,
        "val_freq": 2,
        "save_checkpoint_epoch": 30,
        "print_freq": 2,
        "ema_decay": 0.999,
        "warmup_iter": -1,
        "scheduler":{
            "type": "CosineAnnealingRestartCyclicLR",
            "periods": [15, 15,15,16],
            "restart_weights": [1,1,0.5,0.5],
            "eta_mins": [0.0003, 0.00001, 0.00001, 0.00001]
        },
        "optimizer": {
            "type": "AdamW",
            "lr": 3e-4,
            "weight_decay": 1e-4
        }
    }
}